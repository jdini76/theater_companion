NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# External TTS providers (optional — default public URLs are used if omitted)
NEXT_PUBLIC_ELEVENLABS_API_URL=https://api.elevenlabs.io
NEXT_PUBLIC_DEEPGRAM_API_URL=https://api.deepgram.com

# PostHog analytics (optional — analytics are disabled when this key is absent)
# Get your key at https://us.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# Override to use EU cloud or a self-hosted instance (default: US cloud)
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
